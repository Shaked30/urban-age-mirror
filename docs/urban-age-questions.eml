    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .email-container {
            background-color: #ffffff;
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        h1 {
            color: #2563eb;
            font-size: 28px;
            margin-bottom: 10px;
            border-bottom: 3px solid #2563eb;
            padding-bottom: 10px;
        }
        h2 {
            color: #1e40af;
            font-size: 20px;
            margin-top: 30px;
            margin-bottom: 15px;
            padding: 10px;
            background-color: #eff6ff;
            border-left: 4px solid #2563eb;
        }
        h3 {
            color: #374151;
            font-size: 17px;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .intro {
            background-color: #fef3c7;
            padding: 20px;
            border-radius: 6px;
            margin-bottom: 30px;
            border-left: 4px solid #f59e0b;
        }
        .section {
            margin-bottom: 25px;
        }
        .question-group {
            background-color: #f9fafb;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 15px;
        }
        .question {
            margin: 10px 0;
            padding: 8px 0;
        }
        .checkbox {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid #9ca3af;
            border-radius: 3px;
            margin-left: 10px;
            vertical-align: middle;
        }
        .priority-high {
            background-color: #fef2f2;
            border-left: 4px solid #ef4444;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }
        .priority-medium {
            background-color: #fffbeb;
            border-left: 4px solid #f59e0b;
        }
        .emoji {
            font-size: 24px;
            margin-left: 8px;
        }
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 2px solid #e5e7eb;
            color: #6b7280;
            font-size: 14px;
        }
        ul {
            list-style: none;
            padding-right: 0;
        }
        li {
            margin: 8px 0;
            padding-right: 25px;
            position: relative;
        }
        li:before {
            content: "▸";
            color: #2563eb;
            font-weight: bold;
            position: absolute;
            right: 0;
        }
        strong {
            color: #1f2937;
        }
        .action-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 8px;
            margin: 30px 0;
        }
        .action-box h3 {
            color: white;
            margin-top: 0;
        }
        .action-box ul li:before {
            color: #fbbf24;
        }
