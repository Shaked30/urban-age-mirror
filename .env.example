# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email to receive form notifications (Urban Age team email)
RESEND_FROM_EMAIL=noreply@urban-age.com
NOTIFICATION_EMAIL=tal@urban-age.com

# Google Sheets Configuration
# Your Google Sheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account Credentials (JSON format)
# See FORM_INTEGRATION_SETUP.md for instructions
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}
